# Dummy testdrive values. Nothing here is a real Snapie secret.
# Copy to .env.testdrive to override server-side values at container start.
# NEXT_PUBLIC_* values are read when the image is built, from this example
# file. Changing them in .env.testdrive does not change the client bundle
# until the image is rebuilt from an edited example.

# UI theme. Known names include nounish, bluesky, hacker, forest, cannabis,
# hivebr, windows95.
NEXT_PUBLIC_THEME=nounish

# Public Hive community the explore and composer paths use. This is a public
# community id, not a credential. Leave the search tag aligned with it.
NEXT_PUBLIC_HIVE_COMMUNITY_TAG=hive-167980
NEXT_PUBLIC_HIVE_SEARCH_TAG=hive-167980
# Observer account for a few public Hive reads. Blank falls back to an empty
# observer or the in-code default account name.
NEXT_PUBLIC_HIVE_USER=snapie

# Optional payout display currency (BRL, EUR, GBP, JPY, AUD, CAD, CHF, CNY, INR).
# Blank keeps HBD/USD.
NEXT_PUBLIC_DISPLAY_CURRENCY=

# HiveSigner stays off. Keychain, PeakVault, HiveAuth, and Ledger still show
# in the login modal and sign in the browser through Aioha.
NEXT_PUBLIC_HIVESIGNER_ENABLED=false

# Server posting key and account-creation keys. Leave blank. Uploads that
# need a server signature, and the faucet, do not run in this testdrive.
HIVE_POSTING_KEY=
ACCOUNT_CREATOR=
ACCOUNT_KEY=

# Public account name used as a posting-authority delegate and as the
# points-purchase destination. Defaults in code are the same account name.
NEXT_PUBLIC_POSTING_AUTHORITY_ACCOUNT=snapie
NEXT_PUBLIC_POINTS_RECEIVING_ACCOUNT=snapie

# Upload keys. Blank disables server-side image and video upload. Viewing
# images through /api/image-proxy does not need them.
NEXT_PUBLIC_3SPEAK_API_KEY=
NEXT_PUBLIC_IMAGE_SERVER_API_KEY=
NEXT_PUBLIC_GIPHY_API_KEY=
# Older composer path. Blank uses the key already hardcoded in that component.
GIPHY_API_KEY=

# Snapie Auth server. Leave blank. This image does not run or fake that
# server. GET /api/snapie-auth/auth/me with no session cookie answers
# { authenticated: false } locally. Any other /api/snapie-auth/* call answers
# 503 snapie_auth_not_configured.
SNAPIE_AUTH_URL=
# Not read by this tree. Kept blank so it is not confused with a real key.
SNAPIE_AUTH_INTERNAL_KEY=

# Points, roulette, item market, and games. Off, so those screens do not
# call MongoDB. Discovery and the blended sidecar feed stay off for the
# same reason.
NEXT_PUBLIC_ENABLE_POINTS=false
NEXT_PUBLIC_ENABLE_POINTS_ROULETTE=false
NEXT_PUBLIC_ENABLE_POINTS_MARKET=false
NEXT_PUBLIC_ENABLE_GAMES=false
NEXT_PUBLIC_ENABLE_DISCOVERY_SNAPS=false
NEXT_PUBLIC_ENABLE_BLENDED_FEED=false
NEXT_PUBLIC_POINTS_ALLOWLIST=
POINTS_ALLOWLIST=

# Hangouts / OpenPods. Blank API URL shows "Hangouts are not configured"
# instead of opening LiveKit. Do not point this at a real LiveKit deployment
# for the testdrive.
NEXT_PUBLIC_HANGOUTS_API_URL=
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_HANGOUTS_TOKEN_STORAGE=none

# Chat. The JWT value is a dummy so Next can import chat routes during
# `next build` (the module throws if the variable is empty). Chat still
# needs MongoDB, which this compose file does not start. Leave the URI blank.
MONGODB_URI=
MONGODB_DB_NAME=
CHAT_JWT_SECRET=dummy-testdrive-chat-jwt-secret-not-real
NEXT_PUBLIC_CHAT_DEFAULT_CHANNEL=general

# Optional ButrAuth chat sign-in. Blank disables it.
BUTRAUTH_URL=
BUTRAUTH_CHAT_AUDIENCES=
BUTRAUTH_ISSUER=

# Optional push notifications. Blank disables them. Chat history still needs
# MongoDB even if these are set.
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Activity sidecar. Nothing in this compose file listens on 3099. Routes that
# call it catch the failure and return an empty payload.
HIVE_ACTIVITY_SIDECAR_URL=http://127.0.0.1:3099

# Translation. Blank hides the translate action.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=

# Comma-separated Hive account names for the points admin heal screen.
# Irrelevant while points are off.
ADMIN_HIVE_USERNAMES=

# Shorts metadata checker. Blank uses the public default in code.
NEXT_PUBLIC_CHECKER_URL=

# Test-only Mongo URI for one chat graduation test. Not used by the server.
CHAT_TEST_MONGO_URI=

# Set to true only when running a bundle-analyzer build. Leave blank here.
ANALYZE=

# Hold framework scripts until the server-rendered feed image can paint.
# Unset or 1 keeps the hold. 0 sends the original script tags. Default on.
SNAPIE_DEFER_FRAMEWORK_SCRIPTS=1
