# Optional overrides for `docker compose up --build`.
# Compose already defaults these so the command works with no env file.
# Copy to `.env` only if you need to change them. Never commit `.env` or real secrets.
#
# Do not set MONGODB_URI here. Compose sets
# mongodb://mongo:27017/snapiechat and the web container reaches it on the
# mongo service network. A 127.0.0.1 URI is for `pnpm dev` on the host only.
#
#   cp .env.example .env

# Local placeholder. lib/chat/auth.ts refuses to load when this is empty.
CHAT_JWT_SECRET=local-dev-not-a-secret

# Required for the Blocks queue and for a logged-in win to pay Snapie Points.
NEXT_PUBLIC_ENABLE_GAMES=true
NEXT_PUBLIC_ENABLE_POINTS=true

NEXT_PUBLIC_THEME=nounish
NEXT_PUBLIC_HIVE_COMMUNITY_TAG=hive-167980
NEXT_PUBLIC_HIVE_SEARCH_TAG=hive-167980
NEXT_PUBLIC_HIVE_USER=skatedev
SNAPIE_AUTH_URL=http://localhost:3500
